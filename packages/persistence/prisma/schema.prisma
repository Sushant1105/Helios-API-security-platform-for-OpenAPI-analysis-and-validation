datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apis        Api[]

  @@map("projects")
}

model Api {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    ApiVersion[]

  @@index([projectId])
  @@map("apis")
}

model ApiVersion {
  id             String        @id @default(cuid())
  apiId          String
  version        String
  specification  String        @db.Text
  format         String
  openapiVersion String
  contentHash    String
  createdAt      DateTime      @default(now())

  api            Api           @relation(fields: [apiId], references: [id], onDelete: Cascade)
  analysisRuns   AnalysisRun[]

  @@unique([apiId, contentHash])
  @@index([apiId])
  @@index([contentHash])
  @@map("api_versions")
}

model AnalysisRun {
  id           String     @id @default(cuid())
  apiVersionId String
  status       String
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  result       Json

  apiVersion   ApiVersion @relation(fields: [apiVersionId], references: [id], onDelete: Cascade)

  @@index([apiVersionId])
  @@index([status])
  @@index([createdAt])
  @@map("analysis_runs")
}
