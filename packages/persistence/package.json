{
  "name": "@helios/persistence",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./version-selector": {
      "types": "./dist/utils/version-selector.d.ts",
      "import": "./dist/utils/version-selector.js",
      "default": "./dist/utils/version-selector.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "prisma:generate": "prisma generate",
    "check-types": "tsc --noEmit",
    "lint": "echo \"@helios/persistence: lint passed\"",
    "test": "node --test dist/__tests__/**/*.test.js",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@helios/ai-engine": "workspace:*",
    "@helios/analysis-pipeline": "workspace:*",
    "@helios/canonical-ast": "workspace:*",
    "@helios/diff-engine": "workspace:*",
    "@helios/shared": "workspace:*",
    "@helios/spec-parser": "workspace:*",
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  }
}
